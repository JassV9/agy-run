#!/usr/bin/env bash
# agy-run: run one Gemini task through the Antigravity CLI with live, readable output
# in the terminal, plus a raw log and a plain-text copy of the final answer.
#
# Usage:  agy-run MODEL BRIEF_FILE [extra agy flags...]
#   MODEL       e.g. gemini-4-neon-high, gemini-3.8-flash-medium (see `agy models`)
#   BRIEF_FILE  text file holding the prompt (avoids shell-quoting problems)
# Runs in the current directory. Logs go to $AGY_RUN_DIR (default ~/.cache/agy-runs):
#   <stamp>.ndjson    raw stream-json events
#   <stamp>.err       agy stderr (soft-denied permissions, auth errors)
#   <stamp>.md        final response text
#   latest.*          symlinks to the most recent run
# Exit code is agy's exit code; the last line printed is "[agy-run done: STATUS ...]".

set -u
if [ $# -lt 2 ]; then
  echo "usage: agy-run MODEL BRIEF_FILE [extra agy flags...]" >&2
  exit 2
fi
MODEL=$1
BRIEF=$2
shift 2
[ -f "$BRIEF" ] || { echo "agy-run: brief file not found: $BRIEF" >&2; exit 2; }

WATCH="$HOME/.local/share/agy-run/agy-watch.mjs"
DIR="${AGY_RUN_DIR:-$HOME/.cache/agy-runs}"
mkdir -p "$DIR"
STAMP="$(date +%Y%m%d-%H%M%S)-$MODEL"
RAW="$DIR/$STAMP.ndjson"
ERR="$DIR/$STAMP.err"
OUT="$DIR/$STAMP.md"
ln -sfn "$RAW" "$DIR/latest.ndjson"
ln -sfn "$ERR" "$DIR/latest.err"
ln -sfn "$OUT" "$DIR/latest.md"

echo "agy-run: $MODEL in $(pwd)"
echo "agy-run: log $RAW"

agy -p "$(cat "$BRIEF")" --model "$MODEL" --output-format stream-json --print-timeout 15m "$@" \
  2>"$ERR" | tee "$RAW" | node "$WATCH"
CODE=${PIPESTATUS[0]}

# Save the final answer as plain text and report status on one line.
STATUS=$(node -e '
  const fs = require("fs");
  const [raw, out] = process.argv.slice(1);
  let res = null;
  for (const line of fs.readFileSync(raw, "utf8").split("\n")) {
    try { const ev = JSON.parse(line); if (ev.event === "result") res = ev.result; } catch {}
  }
  if (res) fs.writeFileSync(out, res.response || "");
  process.stdout.write(res ? `${res.status} conv=${res.conversation_id}` : "NO_RESULT");
' "$RAW" "$OUT")

if [ -s "$ERR" ]; then
  echo "agy-run: stderr has output (check for soft-denied tools or auth): $ERR"
fi
echo "[agy-run done: $STATUS exit=$CODE answer=$OUT]"
exit "$CODE"
